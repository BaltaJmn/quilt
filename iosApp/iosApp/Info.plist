<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Compose Multiplatform refuses to start without this: it caps the display link at 60 Hz
	     on ProMotion iPhones. See androidx.compose.ui.uikit.PlistSanityCheck. -->
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<!-- Fallback en ingles. Las traducciones viven en <lang>.lproj/InfoPlist.strings. -->
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>To save the image of your habits to your camera roll.</string>
	<!-- La app no usa cifrado propio, solo HTTPS del sistema. Sin esta clave App Store Connect
	     pregunta por el cumplimiento de exportacion en cada build y la retiene hasta responder. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>CFBundleLocalizations</key>
	<array>
		<string>en</string>
		<string>es</string>
		<string>pt</string>
		<string>de</string>
		<string>fr</string>
	</array>
</dict>
</plist>
